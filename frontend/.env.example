# ============================================================================
# LifeOS AI — frontend environment
#
#   cp .env.example .env.local
#
# .env.local is gitignored. Never commit real keys.
#
# Supabase is REQUIRED: it is the auth and storage layer. Without it the
# workspace stays locked and the login page says so. Everything else below is
# optional and degrades honestly when unset.
# ============================================================================

# --- Backend ---------------------------------------------------------------
# Base URL of the FastAPI orchestrator. No trailing slash (one is stripped
# anyway). The backend's CORS_ORIGINS must list the origin you load the UI
# from — it allows http://localhost:3000 by default, so browse to
# localhost:3000, not 127.0.0.1:3000, or the preflight will fail.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# --- Supabase (required) ---------------------------------------------------
# Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase renamed this key. Newer projects issue a PUBLISHABLE key
# (sb_publishable_...); older ones an ANON key (a long JWT). Set whichever your
# dashboard shows — the app reads publishable first, then falls back to anon.
# Both are browser-safe by design: they carry no privileges of their own, and
# Row Level Security is what actually decides who sees what.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY_HERE
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SUPABASE_SERVICE_ROLE_KEY is deliberately NOT used by this project. Every
# read and write runs as the signed-in user so RLS is the real gate. A key that
# bypasses RLS is a key that can leak — do not add one "just in case".

# --- Auth display hint -----------------------------------------------------
# These do NOT authenticate anything. They are printed on the login page so a
# judge can sign in without being told the credentials out of band. The account
# must exist in Supabase Auth with this exact email and password:
#   Dashboard -> Authentication -> Users -> Add user -> tick "Auto Confirm User"
DEMO_EMAIL=judge@lifeos.ai
DEMO_PASSWORD=lifeos-demo

# Set to false for any deployment that is not being judged.
AUTH_SHOW_DEMO_HINT=true

# --- Email (Resend) --------------------------------------------------------
# Powers "Email report" on the unified report. Server-side only — the key is
# read inside a route handler and never reaches the browser. Left blank, the
# button honestly reports that email is not configured instead of pretending to
# send. Free tier: https://resend.com (3,000 emails/month).
RESEND_API_KEY=re_YOUR_KEY_HERE

# The sender. onboarding@resend.dev is Resend's shared sandbox address: no DNS
# setup, but it will ONLY deliver to the address that owns the Resend account.
# To send anywhere else, verify a domain and use an address on it.
RESEND_FROM_EMAIL=LifeOS AI <onboarding@resend.dev>

# Default recipient, used when the send form is left as-is. On a sandbox sender
# this must be your Resend account's own address or delivery will be refused.
# Unset, the app falls back to the signed-in user's email.
RESEND_TO_EMAIL=you@example.com
