# ============================================================================
# LifeOS AI — frontend environment
# Copy to .env.local to override. The app runs with NO env file: the API base
# defaults to the local backend, auth falls back to the demo account below, and
# email reports report themselves as unconfigured rather than failing silently.
#
#   cp .env.example .env.local
#
# .env.local is gitignored. Never commit real keys.
# ============================================================================

# --- Backend ---------------------------------------------------------------
# Base URL of the FastAPI backend. No trailing slash (one is stripped anyway).
# NOTE: the backend's CORS_ORIGINS must list the origin you load the UI from.
# It allows http://localhost:3000 by default — so browse to localhost:3000,
# not 127.0.0.1:3000, or the preflight will fail.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# --- Auth ------------------------------------------------------------------
# LifeOS ships one operator account, held here. Signing in mints an
# HMAC-SHA256-signed, httpOnly session cookie; middleware.ts verifies it on
# every /app request.

# Key the session cookie is signed with. Unset falls back to a built-in
# development key and logs a warning — set a real one before deploying:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# The only credentials the app accepts. Defaults shown; change both for a
# public deploy.
DEMO_EMAIL=judge@lifeos.ai
DEMO_PASSWORD=lifeos-demo

# Prints the credentials above on the login page so a judge can get in without
# being told them. Set to false for any deployment that is not being judged.
AUTH_SHOW_DEMO_HINT=true

# --- Email (Resend) --------------------------------------------------------
# Powers "Email report" on the unified report. Server-side only — the key is
# read inside a route handler and never reaches the browser. Leave RESEND_API_KEY
# blank and the button reports that email is not configured, honestly, instead
# of pretending to send. Free tier: https://resend.com (3,000 emails/month).
RESEND_API_KEY=

# The sender. onboarding@resend.dev is Resend's shared sandbox address: it needs
# no DNS setup, but it will ONLY deliver to the email address that owns the
# Resend account. To send anywhere else, verify a domain in Resend and use an
# address on it, e.g. "LifeOS AI <reports@yourdomain.com>".
RESEND_FROM_EMAIL=LifeOS AI <onboarding@resend.dev>
