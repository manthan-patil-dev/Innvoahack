# ============================================================================
# LifeOS AI — backend environment
# Copy to .env and fill in. The server starts with NONE of these set (it
# falls back to MOCK mode), so the demo can never be blocked on a missing key.
# ============================================================================

# --- LLM backend selection -------------------------------------------------
# auto   : first configured of lyzr -> claude -> openai -> groq -> gemini,
#          else mock                                              (default)
# lyzr   : force Lyzr Studio
# claude : force direct Anthropic API
# openai : force OpenAI
# groq   : force Groq
# gemini : force Gemini
# mock   : force scripted fixtures, no network
#
# NOTE: in every mode except `mock`, fixtures remain the last fallback, so a
# provider outage degrades the demo rather than ending it. Use `mock` to serve
# fixtures exclusively.
LLM_BACKEND=auto

# --- Anthropic (direct) ----------------------------------------------------
# Leave blank to skip Anthropic entirely.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# --- OpenAI-compatible providers -------------------------------------------
# OpenAI, Groq and Gemini share one /chat/completions contract and one backend
# class. Set only the providers you have; blank keys are skipped.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.0-flash

# --- Lyzr Studio (optional) ------------------------------------------------
# Leave LYZR_API_KEY blank to skip Lyzr entirely.
LYZR_API_KEY=
LYZR_BASE_URL=https://agent-prod.studio.lyzr.ai
LYZR_USER_ID=lifeos-demo@example.com
# Map each LifeOS agent to a Lyzr Studio agent id. Any agent left blank
# automatically falls through to the Claude backend.
LYZR_AGENT_ID_INTENT=
LYZR_AGENT_ID_PLANNER=
LYZR_AGENT_ID_FINANCE=
LYZR_AGENT_ID_TRAVEL=
LYZR_AGENT_ID_SECURITY=
LYZR_AGENT_ID_DOCUMENT=
LYZR_AGENT_ID_CRITIC=
LYZR_AGENT_ID_RESPONSE=

# --- Supabase (not wired yet — schema step is deferred) --------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DEMO_USER_ID=00000000-0000-0000-0000-000000000001

# --- Server ----------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
AGENT_TIMEOUT_SECONDS=60
