# ============================================================================
# LifeOS AI — backend environment
# Copy to .env and fill in. The server starts with NONE of these set (it
# falls back to MOCK mode), so the demo can never be blocked on a missing key.
# ============================================================================

# --- LLM backend selection -------------------------------------------------
# auto   : first configured of lyzr -> claude -> openai -> groq -> gemini,
#          else mock                                              (default)
# lyzr   : force Lyzr Studio
# claude : force direct Anthropic API
# openai : force OpenAI
# groq   : force Groq
# gemini : force Gemini
# mock   : force scripted fixtures, no network
#
# NOTE: in every mode except `mock`, fixtures remain the last fallback, so a
# provider outage degrades the demo rather than ending it. Use `mock` to serve
# fixtures exclusively.
#
# `groq` is the recommended setting for a live demo: it is free-tier friendly and
# is the provider this project has actually been run against. `auto` will try
# every configured provider in order, which wastes a round trip per agent on any
# provider whose key is expired or rate-limited.
LLM_BACKEND=groq

# --- Anthropic (direct) — OPTIONAL, off by default --------------------------
# Not required and not installed: see the note in requirements.txt. The Claude
# backend is only built when this key is set, and its import lives inside that
# constructor, so leaving this blank costs nothing.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# --- OpenAI-compatible providers -------------------------------------------
# OpenAI, Groq and Gemini share one /chat/completions contract and one backend
# class. Set only the providers you have; blank keys are skipped.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.0-flash

# --- Lyzr Studio (optional) ------------------------------------------------
# Leave LYZR_API_KEY blank to skip Lyzr entirely.
LYZR_API_KEY=
LYZR_BASE_URL=https://agent-prod.studio.lyzr.ai
LYZR_USER_ID=lifeos-demo@example.com
# Map each LifeOS agent to a Lyzr Studio agent id. Any agent left blank
# automatically falls through to the Claude backend.
LYZR_AGENT_ID_INTENT=
LYZR_AGENT_ID_PLANNER=
LYZR_AGENT_ID_FINANCE=
LYZR_AGENT_ID_TRAVEL=
LYZR_AGENT_ID_SECURITY=
LYZR_AGENT_ID_DOCUMENT=
LYZR_AGENT_ID_CRITIC=
LYZR_AGENT_ID_RESPONSE=

# --- Server ----------------------------------------------------------------
# Origins allowed to call this API. Add your deployed frontend origin here.
# Auth and email both live in the Next.js app (frontend/.env.local), not here —
# this service has no user model and issues no sessions.
# 3000 is `next dev`; 3100 is the production-build preview (see .claude/launch.json).
CORS_ORIGINS=http://localhost:3000,http://localhost:3100
AGENT_TIMEOUT_SECONDS=60
